# ML agent training checkpoints: ~3 MB each, one every 10 updates, thousands per run.
# Kept out of git by default (GitHub rejects pushes over 2 GB). To keep a milestone:
#   git add -f ml_agent/models/checkpoints/update_NNNNN.pth
ml_agent/models/checkpoints/**/*.pth
ml_agent/__pycache__/

# Engine shader/pipeline cache written by the WebGPU build at runtime (hundreds of .bin files)
Marble Blast Platinum/cache/

# Python bytecode anywhere
__pycache__/
*.pyc

# Navigator trainer: auto-saved numbered checkpoints (~3 MB each, one every 25 updates);
# nav_latest.pth stays tracked as the resume point. Keep a milestone with git add -f.
ml_agent/models/nav/nav_0*.pth
ml_agent/models/nav/*.tmp

# Navigator runtime outputs: per-decision traces (tens of MB), process stdout/stderr,
# game-loop and dashboard output, probe scratch. (The train_nav_*.log exception ended 2026-10-11: *.log below.)
ml_agent/logs/nav/trace_*.csv
ml_agent/logs/nav/trace_*.csv.gz
ml_agent/logs/nav/stdout.txt
ml_agent/logs/nav/stderr.txt
ml_agent/logs/nav/game_loop.txt
ml_agent/logs/nav/dashboard*.txt
ml_agent/logs/probe_sync/
ml_agent/logs/multi_probe_*.txt
# 2026-10-19 (operator): process stderr captures (*.err) stay out of git
*.err

# ml_agent numpy archives (datasets, geometry, demos): too large for the repo; kept on disk only (2026-10-02)
*.npz

# 2026-10-09 (operator): Super Speed fire recordings and check-batch round summaries stay on disk, out of git
ml_agent/logs/nav/live_starts_*.jsonl
ml_agent/logs/nav/blockclusters/*.rounds.jsonl
ml_agent/logs/nav/real_run_*.json

# 2026-10-09 (operator): no model checkpoints in git at all; milestones are described in ml_agent/models/CHECKPOINTS.md
*.pth
# 2026-10-10 (operator): no per-decision trace CSVs in git, anywhere (the committed ones stay until untracked)
*.csv
# 2026-10-11 (operator): no JSON files in git. The game's own JSON data (Marble Blast Platinum/**, build-packages.json)
# stays tracked because the game needs it; ignoring only stops NEW JSON files from being picked up
*.json
# 2026-10-11 (operator): no .jsonl or .txt files in git. Still tracked (not affected): the game's own text data
# (Marble Blast Platinum/platinum/**: help pages, login terms, gamecontrollerdb.txt, readmes) and ml_agent/requirements.txt
*.jsonl
*.txt
# 2026-10-11 (operator): no .log files in git (all were logs: training, datasets, game crash uploads)
*.log
# 2026-10-16 (operator): no .out files in git (pool launch output, monitor and probe stdout)
*.out
# 2026-10-11 (operator): no temp files and no run STOP markers in git (the STOP files stay on disk: they keep runs stopped)
*.tmp
STOP
# 2026-10-12 (operator): no .gz files in git (collision-map snapshots, compressed traces, datasets stay on disk)
*.gz

# Generated historical sources are packed after verification, not loose .py trees.
ml_agent/dynamics_reports/**/*.zip
ml_agent/datasets/marble_dynamics/**/*.zip

# 2026-10-29 (operator): experiment result folders stay on disk, out of git (they hold the map-best evidence and the code
# copies each run saved); the campaign tools live in ml_agent/tools/
ml_agent/dynamics_reports/overnight_20261026/
ml_agent/dynamics_reports/traversal_recovery_20261026/
ml_agent/dynamics_reports/planner_review_20261026/
